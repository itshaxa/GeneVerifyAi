# GeneVerify AI frontend configuration.
#
# Development:  copy to .env.local  (npm run dev reads it automatically).
#               Omitting the file is fine — the dev build then uses the local
#               uvicorn default below.
# Production:   set VITE_API_BASE_URL in the build environment before
#               `npm run build` (CI variables, `export`, a platform env setting).
#               Point it at the deployed backend, e.g.
#                 VITE_API_BASE_URL=https://api.your-project.example/api/v1
#               If it is left unset, the production build falls back to the
#               same-origin path /api/v1, which is what a reverse-proxy
#               deployment (one host serving frontend + API) needs.
#
# ONLY public values may appear here. VITE_* variables are compiled into the
# browser bundle and readable by anyone: never put JWT_SECRET_KEY,
# DATABASE_URL, DEMO_ADMIN_PASSWORD, QWEN_API_KEY or any cloud credential here.
# Those belong to backend/.env only.

# Base URL of the FastAPI backend (including the versioned API prefix).
VITE_API_BASE_URL=http://localhost:8000/api/v1
