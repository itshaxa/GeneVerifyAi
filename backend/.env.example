# GeneVerify AI backend configuration (copy to .env and adjust)
# NEVER commit real secrets. Every value below is a safe development default.
#
# Configuration is read by app/core/config.py (pydantic-settings), which takes
# real environment variables first and this file second. On a deployment
# platform, set these as platform environment variables / secret store entries
# and do not ship a .env file at all.
#
# ---------------------------------------------------------------------------
# TO PRODUCE A PRODUCTION INSTANCE you must change at least:
#   APP_ENV=production
#   DEBUG=false                      (production refuses DEBUG=true)
#   JWT_SECRET_KEY=<random secret>   (production refuses the placeholder below)
#   CORS_ORIGINS=<your frontend origin(s)>
#   DATABASE_URL / DOCUMENT_STORAGE_PATH -> writable mounted locations
#   AI_PROVIDER=qwen + QWEN_API_KEY=<key>  (the mock provider is refused in
#                                           production)
#   DEMO_ADMIN_* -> replaced, or seed a real operator account instead
# ---------------------------------------------------------------------------

APP_NAME=GeneVerify AI API
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# Prefix every API route is mounted under (also used by the frontend base URL).
API_PREFIX=/api/v1

# SQLite for the hackathon prototype; swap for a managed RDS/PostgreSQL URL
# when deploying to Alibaba Cloud (e.g. postgresql+psycopg://user:pass@host/db).
# A file-based SQLite path may live in a directory that does not exist yet —
# the startup code creates it, and the app never drops or recreates tables.
DATABASE_URL=sqlite:///./geneverify.db

# Comma-separated list of origins allowed to call this API (frontend dev server).
# Production: the exact public origin(s) of the deployed frontend, e.g.
# CORS_ORIGINS=https://geneverify.example.com
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# --- Authentication (Step 3) ---
# JWT signing secret. The placeholder below is for LOCAL DEVELOPMENT ONLY.
# Production MUST use a strong, randomly generated secret (e.g. 64 hex chars):
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to start in production while this placeholder is in place, and
# the secret is never logged or returned by any endpoint.
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-CHANGE-ME-before-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Synthetic hackathon demo credential, consumed ONLY by
# `python -m app.database.seed_users` (stored as an Argon2 hash, never plaintext).
# MUST be replaced before any production deployment.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=GeneVerify@2026

# --- Document upload (Step 6) ---
# Local filesystem root for uploaded DNA/blood-test documents. Gitignored,
# never served statically and never stored inside the database file. Production:
# point this at a writable mounted volume, e.g. /srv/geneverify/data/documents.
DOCUMENT_STORAGE_PATH=storage/documents
MAX_DOCUMENT_SIZE_MB=10

# --- AI document intelligence (Step 7) ---
# Provider: "qwen" (Alibaba Cloud Qwen) or "mock" (deterministic dev/test
# provider — mock is refused in production). The app starts either way; an
# unconfigured provider simply reports "AI provider is not configured."
# The key is used by the backend only; the frontend never calls Qwen directly.
AI_PROVIDER=mock

# Qwen credentials/endpoint — placeholders only, NEVER commit real keys.
# Uses the OpenAI-compatible DashScope endpoint; change the base URL to
# https://dashscope.aliyuncs.com/compatible-mode/v1 for CN-region accounts.
QWEN_API_KEY=
QWEN_MODEL=qwen-vl-max
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT_SECONDS=60

# --- Server startup (Step 11) ---
# Read by `python run.py` only (plain `uvicorn app.main:app --host/--port` needs
# no values here). Most platforms inject PORT automatically.
# HOST defaults to 127.0.0.1 in development and 0.0.0.0 in production.
# HOST=0.0.0.0
# PORT=8000

# --- Reports (Step 9) ---
# PDF reports are generated in-process with fpdf2 from the existing report
# payload. There is intentionally no report-related configuration: no storage
# bucket, no template path and no external rendering service.
